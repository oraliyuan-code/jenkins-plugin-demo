<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:l="/lib/layout" xmlns:st="jelly:stapler" xmlns:d="jelly:define">
  <l:layout title="${it.displayName}" permission="${app.ADMINISTER}">
    <l:main-panel>
      <h1>插件生命周期演示中心</h1>
      <p>
        本插件通过轻量示例展示 Jenkins 插件常见扩展点：各自在什么生命周期介入、能控制什么、在页面上如何体现。
      </p>

      <div class="jenkins-alert jenkins-alert-info">
        <strong>当前状态：</strong>
        演示功能
        <j:choose>
          <j:when test="${it.globalConfig.enabled}">已启用</j:when>
          <j:otherwise>已禁用</j:otherwise>
        </j:choose>
        ，欢迎语：「${it.globalConfig.welcomeMessage}」
        （可在 <a href="${rootURL}/manage/configure">系统配置</a> 中修改）
      </div>

      <h2>扩展点一览</h2>
      <table class="jenkins-table jenkins-!-margin-bottom-0">
        <thead>
          <tr>
            <th>扩展点</th>
            <th>生命周期</th>
            <th>能控制什么</th>
            <th>页面体现</th>
            <th>本插件示例</th>
            <th>触发次数</th>
          </tr>
        </thead>
        <tbody>
          <j:forEach var="point" items="${it.extensionPoints}">
            <tr>
              <td><strong>${point.name}</strong></td>
              <td>${point.lifecycle}</td>
              <td>${point.controls}</td>
              <td>${point.whereVisible}</td>
              <td><code>${point.demoClass}</code></td>
              <td>${it.getTriggerCount(point.name)}</td>
            </tr>
          </j:forEach>
        </tbody>
      </table>

      <h2>最近事件（内存记录，重启后清空）</h2>
      <form method="post" action="clearLog" class="jenkins-buttons-row jenkins-!-margin-bottom-1">
        <st:nonce/>
        <button type="submit" class="jenkins-button jenkins-button--destructive">清空记录</button>
        <a href="exportLog" class="jenkins-button">导出 CSV</a>
      </form>

      <table class="jenkins-table">
        <thead>
          <tr>
            <th>时间</th>
            <th>扩展点</th>
            <th>阶段</th>
            <th>详情</th>
          </tr>
        </thead>
        <tbody>
          <j:choose>
            <j:when test="${empty(it.recentEvents)}">
              <tr>
                <td colspan="4">暂无记录。请保存全局配置、运行一次 Freestyle/Pipeline 构建，或等待 PeriodicWork 触发。</td>
              </tr>
            </j:when>
            <j:otherwise>
              <j:forEach var="event" items="${it.recentEvents}">
                <tr>
                  <td>${event.formattedTime()}</td>
                  <td>${event.extensionPoint}</td>
                  <td>${event.phase}</td>
                  <td>${event.detail}</td>
                </tr>
              </j:forEach>
            </j:otherwise>
          </j:choose>
        </tbody>
      </table>

      <h2>快速体验</h2>
      <h3>Freestyle 任务</h3>
      <ol>
        <li>新建 Freestyle 任务，勾选「启用演示 Job 属性」</li>
        <li>构建环境：添加「演示构建包装（BuildWrapper）」</li>
        <li>构建步骤：添加「演示构建步骤（Builder）」</li>
        <li>构建后操作：添加「演示构建后操作（Publisher）」</li>
        <li>保存并构建，查看控制台与本页事件记录</li>
      </ol>

      <h3>Pipeline 任务</h3>
      <pre><code>pipeline {
  agent any
  stages {
    stage('Demo') {
      steps {
        demoLifecycle('Pipeline 演示步骤')
      }
    }
  }
}</code></pre>
    </l:main-panel>
  </l:layout>
</j:jelly>
