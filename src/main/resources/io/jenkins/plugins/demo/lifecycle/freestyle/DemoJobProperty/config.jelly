<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:optionalBlock title="演示 Job 属性（JobProperty）" inline="true" checked="${instance.enabled}">
    <f:entry>
      <div class="jenkins-help">
        JobProperty 随任务配置保存，可在任务创建/修改时附加行为或元数据。
      </div>
    </f:entry>
    <f:entry title="启用" field="enabled">
      <f:checkbox default="true"/>
    </f:entry>
  </f:optionalBlock>
</j:jelly>
